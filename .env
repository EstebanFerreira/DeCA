DATABASE_URL="file:./dev.db"
# Secreto usado para firmar las sesiones (JWT). Cambiar en producción por un valor aleatorio largo.
AUTH_SECRET="cambia-este-secreto-en-produccion-por-uno-aleatorio-de-al-menos-32-caracteres"
# URL base pública de la plataforma (debe ser HTTPS con TLS 1.2+ en producción).
# Se usa para construir la URL que se codifica en el QR de cada DeCA.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Carpeta donde se almacenan físicamente los PDF generados (fuera de /public para poder
# controlar el acceso y desactivar la descarga tras los 7 días naturales).
DECA_STORAGE_DIR="./storage/deca"
